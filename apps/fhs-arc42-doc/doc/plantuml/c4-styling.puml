!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

' C4 Model Standard Color Notation
' Based on common practices and accessibility guidelines
!define PERSON_BG_COLOR #08427b
!define PERSON_BORDER_COLOR #052e56
!define SYSTEM_BG_COLOR #1168bd
!define SYSTEM_BORDER_COLOR #0b4884
!define EXTERNAL_BG_COLOR #999999
!define EXTERNAL_BORDER_COLOR #777777
!define CONTAINER_BG_COLOR #438dd5
!define CONTAINER_BORDER_COLOR #2e7cb8
!define COMPONENT_BG_COLOR #85bbf0
!define COMPONENT_BORDER_COLOR #5a9bd4
!define DATABASE_BG_COLOR #23a2f0
!define DATABASE_BORDER_COLOR #1a7bc0

skinparam person {
  BackgroundColor PERSON_BG_COLOR
  FontColor #ffffff
  BorderColor PERSON_BORDER_COLOR
}

skinparam rectangle<<system>> {
  BackgroundColor SYSTEM_BG_COLOR
  FontColor #ffffff
  BorderColor SYSTEM_BORDER_COLOR
  roundCorner 20
}

skinparam rectangle<<external>> {
  BackgroundColor EXTERNAL_BG_COLOR
  FontColor #ffffff
  BorderColor EXTERNAL_BORDER_COLOR
  roundCorner 20
}

skinparam rectangle<<container>> {
  BackgroundColor CONTAINER_BG_COLOR
  FontColor #ffffff
  BorderColor CONTAINER_BORDER_COLOR
  roundCorner 20
}

skinparam rectangle<<component>> {
  BackgroundColor COMPONENT_BG_COLOR
  FontColor #000000
  BorderColor COMPONENT_BORDER_COLOR
  roundCorner 20
}

' Sequence diagram styling with C4 colors
skinparam sequence {
  ParticipantBackgroundColor PERSON_BG_COLOR
  ParticipantBorderColor PERSON_BORDER_COLOR
  ParticipantFontColor #ffffff
  ActorBackgroundColor PERSON_BG_COLOR
  ActorBorderColor PERSON_BORDER_COLOR
  ActorFontColor #ffffff
  LifeLineBackgroundColor SYSTEM_BG_COLOR
  LifeLineBorderColor SYSTEM_BORDER_COLOR
}

skinparam participant {
  BackgroundColor PERSON_BG_COLOR
  BorderColor PERSON_BORDER_COLOR
  FontColor #ffffff
}

skinparam actor {
  BackgroundColor PERSON_BG_COLOR
  BorderColor PERSON_BORDER_COLOR
  FontColor #ffffff
}

skinparam database {
  BackgroundColor DATABASE_BG_COLOR
  FontColor #ffffff
  BorderColor DATABASE_BORDER_COLOR
}

' Legend styling for consistent element sizes
skinparam rectangle<<legend>> {
  MinimumWidth 120
  FontSize 10
}

' C4 Model Color Legend - flush left, each element on a line, EXACT same length (18 chars)
!procedure $SystemContextLegend()
legend top left
|= **C4 Legend** |
|<back:#08427B><color:#FFFFFF> Person            </color></back>|
|<back:#1168BD><color:#FFFFFF> Software System   </color></back>|
|<back:#999999><color:#FFFFFF> External System   </color></back>|
endlegend
!endprocedure

!procedure $ContainerLegend()
legend top left
|= **C4 Legend** |
|<back:#08427B><color:#FFFFFF> Person            </color></back>|
|<back:#438DD5><color:#FFFFFF> Container         </color></back>|
|<back:#23A2F0><color:#FFFFFF> Database          </color></back>|
|<back:#999999><color:#FFFFFF> External System   </color></back>|
endlegend
!endprocedure

!procedure $ComponentLegend()
legend top left
|= **C4 Legend** |
|<back:#85BBF0><color:#000000> Component         </color></back>|
|<back:#23A2F0><color:#FFFFFF> Database          </color></back>|
|<back:#999999><color:#FFFFFF> External System   </color></back>|
endlegend
!endprocedure

!procedure $SequenceLegend()
legend top left
|= **C4 Legend** |
|<back:#08427B><color:#FFFFFF> Person            </color></back>|
|<back:#438DD5><color:#FFFFFF> Container         </color></back>|
|<back:#85BBF0><color:#000000> Component         </color></back>|
|<back:#999999><color:#FFFFFF> External System   </color></back>|
endlegend
!endprocedure
