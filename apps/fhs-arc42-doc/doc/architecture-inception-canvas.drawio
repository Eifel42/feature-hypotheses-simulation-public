        <mxCell id="698" value="" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=none;strokeWidth=3;fillColor=#e8edf0;fontSize=60;fontColor=#2F5B7C;align=left;" parent="1" vertex="1">
          <mxGeometry x="-2310" y="70" width="2250" height="1560" as="geometry" />
        </mxCell>
        <mxCell id="702" value="&lt;div&gt;&lt;span style='font-size:26px;font-weight:bold'&gt;Business Context&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Product Owner compares expected business value and risk floor for candidate features.&lt;/li&gt;&lt;li&gt;Financial Risk Manager reviews CVaR, correlation assumptions, and stress scenarios.&lt;/li&gt;&lt;li&gt;Business Stakeholder uses notebook and CLI reports for funding decisions.&lt;/li&gt;&lt;li&gt;System context diagram is embedded below in this canvas panel (no external link required).&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=#e8edf0;strokeWidth=5;fillColor=#ffffff;fontSize=12;fontColor=#2F5B7C;align=left;verticalAlign=top;spacing=30;" parent="1" vertex="1">
          <mxGeometry x="-1710" y="400" width="1020" height="770" as="geometry" />
        </mxCell>
        <mxCell id="703" value="&lt;div&gt;&lt;span style='font-size:26px;font-weight:bold'&gt;Business Case&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Product teams make backlog decisions under uncertainty (users, conversion, business value, and development cost).&lt;/li&gt;&lt;li&gt;Poor prioritization wastes capacity and budget.&lt;/li&gt;&lt;li&gt;FHS combines Monte Carlo simulation with VaR/CVaR so Product Owners and Risk Managers can quantify downside in EUR before funding decisions.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=#e8edf0;strokeWidth=5;fillColor=#ffffff;fontSize=12;fontColor=#2F5B7C;align=left;verticalAlign=top;spacing=30;" parent="1" vertex="1">
          <mxGeometry x="-2220" y="250" width="2040" height="140" as="geometry" />
        </mxCell>
        <mxCell id="704" value="&lt;div&gt;&lt;span style='font-size:26px;font-weight:bold'&gt;Functional Overview&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Local-first Python package with Jupyter notebooks and planning CLI.&lt;/li&gt;&lt;li&gt;No REST API, no database, and no server-side platform.&lt;/li&gt;&lt;li&gt;Main flow: scenario input -&gt; simulation -&gt; risk metrics -&gt; budget recommendation.&lt;/li&gt;&lt;li&gt;Core modules: simulation, risk, portfolio, application orchestration, and scenario service.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=#e8edf0;strokeWidth=5;fillColor=#ffffff;fontSize=12;fontColor=#2F5B7C;align=left;verticalAlign=top;spacing=30;" parent="1" vertex="1">
          <mxGeometry x="-2220" y="400" width="500" height="380" as="geometry" />
        </mxCell>
        <mxCell id="oz0HphpjMoNRiyryh3UB-722" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="-2220" y="114" width="179.91" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bHtJGvRWZrA99JSl9f75-730" value="&lt;div&gt;&lt;span style='font-size:26px;font-weight:bold'&gt;Architecture Hypotheses&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;H1: KISS over infrastructure - local library + CLI minimize deployment and operations complexity.&lt;/li&gt;&lt;li&gt;H2: Notebooks are first-class presentation components; DDD layering keeps business logic separated.&lt;/li&gt;&lt;li&gt;H3: Correlation-aware portfolio analysis improves realism over naive diversification assumptions.&lt;/li&gt;&lt;li&gt;H4: Exact combinatorial selection plus greedy budget/sprint optimization keeps runtime practical.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=#e8edf0;strokeWidth=5;fillColor=#ffffff;fontSize=12;fontColor=#2F5B7C;align=left;verticalAlign=top;spacing=30;" parent="1" vertex="1">
          <mxGeometry x="-2220" y="1180" width="1010" height="210" as="geometry" />
        </mxCell>
        <mxCell id="bHtJGvRWZrA99JSl9f75-732" value="&lt;div&gt;&lt;span style='font-size:26px;font-weight:bold'&gt;Quality Goals&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Correctness: VaR 95% within +/-1% for fixed seeds.&lt;/li&gt;&lt;li&gt;Simplicity: first assessment in &lt;15 minutes without coaching.&lt;/li&gt;&lt;li&gt;Transparency: key metrics shown in EUR with plain-language explanations.&lt;/li&gt;&lt;li&gt;Decision support: output directly supports build/skip, priority, and budget-fit decisions.&lt;/li&gt;&lt;li&gt;Accessibility: all chart colours reference semantic palette tokens (WCAG 2.1 AA, ≥ 4.5:1 contrast); no hardcoded hex literals.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;shadow=0;labelBackgroundColor=none;strokeColor=#e8edf0;strokeWidth=5;fillColor=#ffffff;fontSize=12;fontColor=#2F5B7C;align=left;verticalAlign=top;spacing=30;" parent="1" vertex="1">
          <mxGeometry x="-2220" y="790" width="500" height="380" as="geometry" />
        </mxCell>
        <mxCell id="bHtJGvRWZrA99JSl9f75-741" value="&lt;font face=&quot;Helvetica&quot; style=&quot;font-size: 28px;&quot;&gt;https://canvas.arc42.org&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=42;fontColor=#2f5c7c;fontStyle=1;fontFamily=Mark Pro;" parent="1" vertex="1">
