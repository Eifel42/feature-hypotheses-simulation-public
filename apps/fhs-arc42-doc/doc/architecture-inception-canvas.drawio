        <mxCell id="bHtJGvRWZrA99JSl9f75-774" value="Date / Iteration:" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Helvetica;fontColor=#999999;" parent="1" vertex="1">
