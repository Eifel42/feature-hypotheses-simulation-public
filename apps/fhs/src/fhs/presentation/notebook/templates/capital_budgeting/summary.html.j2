{#
  Capital Budgeting Summary Template

  Context variables:
  - title: str
  - rows: list[tuple[str, float_a, float_b, str]]  — (label, val_a, val_b, row_type)
      row_type: "npv" | "floor" | "irr" | "pi"
  - irr_a_expected: float  (may be nan — use `is nan` test)
  - irr_b_expected: float
  - discount_rate: float
  - benefit: float          (npv_b.expected - npv_a.expected)
  - benefit_floor: float    (npv_b.var_95 - npv_a.var_95)
  - verdict_message: str
  - verdict_is_go: bool
#}

{# ── helpers ────────────────────────────────────────────────────────────── #}

{% macro signed_eur(v, font_size="") %}
  {%- set color = COLORS.success if v >= 0 else COLORS.danger -%}
  {%- set sign  = "+" if v >= 0 else "−" -%}
  <span style="font-weight:700;{% if font_size %}font-size:{{ font_size }};{% endif %}color:{{ color }};">{{ sign }}€{{ v | abs | thousands }}</span>
{%- endmacro %}

{% macro irr_cell(v) %}
  {%- if v is nan -%}
    <span style="color:{{ COLORS.success }};font-weight:600;">Positive Y1 ∞</span>
  {%- else -%}
    {%- set color = COLORS.success if v >= discount_rate else COLORS.danger -%}
    <span style="font-weight:600;color:{{ color }};">{{ "%.0f" | format(v * 100) }}%</span><span style="color:{{ COLORS.neutral }};font-size:11px;"> vs {{ "%.0f" | format(discount_rate * 100) }}% hurdle</span>
  {%- endif %}
{%- endmacro %}

{% macro pi_cell(v) %}
  {%- set color = COLORS.success if v >= 1 else COLORS.danger -%}
  <span style="font-weight:700;font-size:15px;color:{{ color }};">{{ "%.2f" | format(v) }}×</span><span style="color:{{ COLORS.neutral }};font-size:11px;"> per €1 invested</span>
{%- endmacro %}

{# ── benefit helpers ───────────────────────────────────────────────────── #}
{% set benefit_color = COLORS.success if benefit >= 0 else COLORS.danger %}
{% set benefit_sign  = "+" if benefit >= 0 else "−" %}
{% set bfloor_sign   = "+" if benefit_floor >= 0 else "−" %}

{# ── main wrapper ──────────────────────────────────────────────────────── #}
<div style="margin:8px 0">
  <div style="font-size:16px;font-weight:700;padding:6px 0 10px;color:{{ COLORS.neutral }};border-bottom:2px solid {{ COLORS.border }};margin-bottom:10px">{{ title }}</div>
  <div style="border:1px solid {{ COLORS.border }};border-radius:8px;overflow:auto">
    <table style="width:100%;border-collapse:collapse">
      <tr style="background:{{ COLORS.border }};font-size:12px">
        <th style="padding:8px 14px;text-align:left;color:{{ COLORS.neutral }}">Metric</th>
        <th style="padding:8px 14px;text-align:right;color:{{ COLORS.primary }}">Option A — Upfront</th>
        <th style="padding:8px 14px;text-align:right;color:{{ COLORS.success }}">Option B — Installment</th>
      </tr>
      <tr style="background:{{ alternating_bg(0) }}">
        <td style="padding:9px 14px;font-size:13px;color:{{ COLORS.neutral }}">NPV — Expected</td>
        <td style="padding:9px 14px;text-align:right">{{ signed_eur(npv_a_expected, "15px") }}</td>
        <td style="padding:9px 14px;text-align:right">{{ signed_eur(npv_b_expected, "15px") }}</td>
      </tr>
      <tr style="background:{{ alternating_bg(1) }}">
        <td style="padding:9px 14px;font-size:13px;color:{{ COLORS.neutral }}">NPV — Floor (VaR 95%)</td>
        <td style="padding:9px 14px;text-align:right">{{ signed_eur(npv_a_var95, "12px") }}</td>
        <td style="padding:9px 14px;text-align:right">{{ signed_eur(npv_b_var95, "12px") }}</td>
      </tr>
      <tr style="background:{{ alternating_bg(2) }}">
        <td style="padding:9px 14px;font-size:13px;color:{{ COLORS.neutral }}">IRR — Expected</td>
        <td style="padding:9px 14px;text-align:right">{{ irr_cell(irr_a_expected) }}</td>
        <td style="padding:9px 14px;text-align:right">{{ irr_cell(irr_b_expected) }}</td>
      </tr>
      <tr style="background:{{ alternating_bg(3) }}">
        <td style="padding:9px 14px;font-size:13px;color:{{ COLORS.neutral }}">Profitability Index (PI)</td>
        <td style="padding:9px 14px;text-align:right">{{ pi_cell(pi_a) }}</td>
        <td style="padding:9px 14px;text-align:right">{{ pi_cell(pi_b) }}</td>
      </tr>
      {# benefit row #}
      <tr style="background:{{ COLORS.surface }};border-top:2px solid {{ benefit_color }}">
        <td style="padding:10px 14px;font-size:13px;font-weight:700;color:{{ benefit_color }}">Option B advantage (B − A)</td>
        <td style="padding:10px 14px;text-align:right;color:{{ COLORS.neutral }};font-size:12px">NPV floor {{ bfloor_sign }}€{{ benefit_floor | abs | thousands }}</td>
        <td style="padding:10px 14px;text-align:right;font-size:17px;font-weight:900;color:{{ benefit_color }}">{{ benefit_sign }}€{{ benefit | abs | thousands }}</td>
      </tr>
    </table>
  </div>
  {% if verdict_message %}
  <div style="margin-top:10px;padding:8px 14px;border-left:4px solid {{ COLORS.success if verdict_is_go else COLORS.warning }};background:{{ COLORS.success_surface if verdict_is_go else COLORS.surface }};font-size:13px;color:{{ COLORS.neutral }}">{{ verdict_message }}</div>
  {% endif %}
</div>
