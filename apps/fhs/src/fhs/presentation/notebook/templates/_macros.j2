{# Reusable KPI cell for grid layouts #}
{% macro kpi_cell(value, label, color=COLORS.secondary) %}
<div style="background:{{ COLORS.background }};padding:12px;border-radius:4px;text-align:center;border:1px solid {{ COLORS.border }};"><div style="font-size:22px;font-weight:bold;color:{{ color }};">{{ value }}</div><div style="font-size:12px;color:{{ COLORS.neutral }};font-weight:bold;text-transform:uppercase;">{{ label }}</div></div>
{% endmacro %}
