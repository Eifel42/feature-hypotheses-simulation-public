{# feature_risk_card.html.j2 — Single feature risk card #}
{% from "_macros.j2" import kpi_cell %}
<div style="flex:1;min-width:260px;background:white;border-radius:4px;padding:20px;border:1px solid {{ COLORS.border }};border-top:4px solid {{ color }};"><div style="font-size:18px;font-weight:bold;color:{{ COLORS.neutral }};margin-bottom:10px;">{{ icon }} {{ name }}</div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:8px;">{{ kpi_cell('EUR ' ~ '{:,.0f}'.format(expected_eur), 'Expected', COLORS.secondary) }}{{ kpi_cell('EUR ' ~ '{:,.0f}'.format(var95_eur), 'VaR 95% Floor', COLORS.danger) }}{{ kpi_cell('EUR ' ~ '{:,.0f}'.format(cvar95_eur), 'CVaR 95% Tail', COLORS.danger) }}</div><div style="margin-top:10px;font-size:13px;color:{{ COLORS.neutral }};">{{ light }} Risk Ratio: {{ '{:.0%}'.format(risk_ratio) }}</div></div>
