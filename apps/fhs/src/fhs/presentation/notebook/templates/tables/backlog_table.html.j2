{# backlog_table.html.j2 — Feature backlog with strategic categories #}
<div style="{{ card_wrapper(padding='20px') }};color:{{ COLORS.neutral }};"><h3 style="margin-top:0;color:{{ COLORS.neutral }};">📋 {{ title }}</h3><table style="{{ table_base(font_size='13px', margin='0') }}"><tr style="background:{{ COLORS.surface }};font-weight:bold;color:{{ COLORS.neutral }};"><th style="padding:8px;text-align:left;">Feature</th><th style="padding:8px;text-align:left;">Category</th><th style="padding:8px;text-align:right;">Users</th><th style="padding:8px;">Conv%</th><th style="padding:8px;">Risk</th><th style="padding:8px;text-align:right;">Exp. Business Value</th><th style="padding:8px;text-align:right;">Dev Cost</th><th style="padding:8px;text-align:right;">Est. ROI</th></tr>
{% for r in rows %}
{% set f = r.feature %}
{% set risk = "🟢" if f.uncertainty < 0.25 else ("🟡" if f.uncertainty < 0.40 else "🔴") %}
{% set roi_col = COLORS.secondary if r.roi > 0 else COLORS.danger %}
{% set roi_warn = "" if r.roi > 0 else " ⚠️" %}
<tr><td style="padding:8px;font-weight:bold;color:{{ COLORS.neutral }};">{{ f.name }}</td><td style="padding:8px;font-size:12px;color:#555;">{{ r.category }}</td><td style="padding:8px;text-align:right;color:{{ COLORS.neutral }};">{{ '{:,}'.format(f.expected_users) }}</td><td style="padding:8px;text-align:center;color:{{ COLORS.neutral }};">{{ '{:.0%}'.format(f.conversion_rate) }}</td><td style="padding:8px;text-align:center;color:{{ COLORS.neutral }};">{{ risk }} {{ '{:.0%}'.format(f.uncertainty) }}</td><td style="padding:8px;text-align:right;color:{{ COLORS.neutral }};">EUR {{ '{:,.0f}'.format(r.exp_rev) }}</td><td style="padding:8px;text-align:right;color:{{ COLORS.neutral }};">EUR {{ '{:,.0f}'.format(f.development_cost) }}</td><td style="padding:8px;text-align:right;font-weight:bold;color:{{ roi_col }};">{{ '{:+.0f}'.format(r.roi) }}%{{ roi_warn }}</td></tr>
{% endfor %}
</table><div style="margin-top:12px;padding:10px 14px;background:{{ COLORS.surface }};border-radius:4px;font-size:13px;"><b>Portfolio total:</b> Business Value EUR {{ '{:,.0f}'.format(total_rev) }} | Cost EUR {{ '{:,.0f}'.format(total_cost) }} | <span style="font-weight:bold;color:{{ COLORS.secondary if portfolio_roi > 0 else COLORS.danger }};">ROI {{ '{:+.0f}'.format(portfolio_roi) }}%</span><br><span style="color:#555;">⚠️ Features with negative ROI are included for regulatory or strategic reasons - see category column.</span></div></div>
