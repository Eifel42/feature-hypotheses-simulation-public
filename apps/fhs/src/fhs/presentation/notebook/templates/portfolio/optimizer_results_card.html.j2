{# optimizer_results_card.html.j2 — Portfolio optimization results #}
<div style="{{ card_wrapper(padding='25px') }};border-left:5px solid {{ accent }};color:{{ COLORS.neutral }};"><h3 style="margin-top:0;color:{{ COLORS.neutral }};">{{ title }}</h3>{% if objective %}<div style="font-size:13px;color:{{ COLORS.neutral }};margin:-8px 0 14px 0;opacity:0.75;">Objective: {{ objective }}</div>{% endif %}<div style="display:flex;gap:10px;flex-wrap:wrap;margin:15px 0;">
{% for name in selected %}
<div style="background:{{ COLORS.background }};padding:10px 20px;border-radius:4px;font-weight:bold;color:{{ COLORS.neutral }};">✅ {{ name }}</div>
{% endfor %}
</div><div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:15px;margin-top:10px;"><div style="background:{{ COLORS.surface }};padding:12px;border-radius:4px;"><div style="font-size:12px;color:{{ COLORS.neutral }};font-weight:600;">TOTAL COST</div><div style="font-size:18px;font-weight:bold;color:{{ COLORS.neutral }};">EUR {{ '{:,.0f}'.format(total_cost) }}</div></div><div style="background:{{ COLORS.surface }};padding:12px;border-radius:4px;"><div style="font-size:12px;color:{{ COLORS.neutral }};font-weight:600;">BUDGET REMAINING</div><div style="font-size:18px;font-weight:bold;color:{{ COLORS.secondary }};">EUR {{ '{:,.0f}'.format(budget_remaining) }}</div></div><div style="background:{{ COLORS.surface }};padding:12px;border-radius:4px;"><div style="font-size:12px;color:{{ COLORS.neutral }};font-weight:600;">BUDGET PRESSURE</div><div style="font-size:18px;font-weight:bold;color:{% if budget_pressure <= 0 %}{{ COLORS.success }}{% else %}{{ COLORS.danger }}{% endif %};">{{ '{:+.1%}'.format(budget_pressure) }}</div></div><div style="background:{{ COLORS.surface }};padding:12px;border-radius:4px;"><div style="font-size:12px;color:{{ COLORS.neutral }};font-weight:600;">EXPECTED PROFIT</div><div style="font-size:11px;color:{{ COLORS.neutral }};opacity:0.65;">E[BV] − upfront cost</div><div style="font-size:18px;font-weight:bold;color:{{ COLORS.secondary }};">EUR {{ '{:,.0f}'.format(net_value) }}</div></div><div style="background:{{ COLORS.surface }};padding:12px;border-radius:4px;"><div style="font-size:12px;color:{{ COLORS.neutral }};font-weight:600;">VAR 95%</div><div style="font-size:18px;font-weight:bold;color:{{ COLORS.warning }};">EUR {{ '{:,.0f}'.format(var95) }}</div></div><div style="background:{{ COLORS.surface }};padding:12px;border-radius:4px;"><div style="font-size:12px;color:{{ COLORS.neutral }};font-weight:600;">CVAR 95%</div><div style="font-size:18px;font-weight:bold;color:{{ COLORS.danger }};">EUR {{ '{:,.0f}'.format(cvar95) }}</div></div></div></div>
