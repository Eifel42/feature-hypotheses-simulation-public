# Lightweight web server for Arc42 documentation
# Pin by SHA digest for supply-chain immutability.
# To update: docker pull nginx:1.27-alpine && docker inspect --format='{{index .RepoDigests 0}}' nginx:1.27-alpine
FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

LABEL maintainer="eifel42.dev"
LABEL description="Arc42 documentation server for Feature Hypotheses Simulation"

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Fallback page shown when docs/html5/ has not been built yet.
# Stored outside the volume-mount path so it survives an empty mount.
RUN mkdir -p /usr/share/nginx/fallback
COPY cicd/containers/docs-not-built.html /usr/share/nginx/fallback/index.html

# Custom nginx config for single-page doc serving
COPY cicd/containers/nginx-docs.conf /etc/nginx/conf.d/default.conf

# Docs will be mounted at /usr/share/nginx/html
EXPOSE 8085

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:8085/ || exit 1
