# ==============================================================================
# FHS Docker Compose Dev Environment Configuration
# ==============================================================================
# Copy to cicd/.env.local for machine-specific settings.

FHS_ENV=development

# Required before starting Jupyter. Generate with: openssl rand -hex 16
JUPYTER_TOKEN=CHANGE_ME_generate_with_openssl_rand_hex_16
JUPYTER_PORT=8888
JUPYTER_ENABLE_LAB=yes
JUPYTER_ALLOW_REMOTE_ACCESS=1

DOCS_PORT=8085
# External SonarQube only — localhost URLs are rejected by cicd/run-cicd.sh.
SONAR_HOST_URL=
SONAR_TOKEN=

PYTHONPATH=/workspace/src
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

OPENBLAS_NUM_THREADS=4
MKL_NUM_THREADS=4
OMP_NUM_THREADS=4
NUMEXPR_MAX_THREADS=4
MALLOC_ARENA_MAX=4

DOCKER_BUILDKIT=1
BUILDKIT_PROGRESS=plain
BUILDPLATFORM=linux/arm64

LOG_LEVEL=INFO
LOG_FORMAT=simple
DEBUG=false
CACHE_DIR=.cache

FHS_DEV_MEMORY_LIMIT=8g
FHS_DEV_OPENBLAS_NUM_THREADS=1
FHS_DEV_MKL_NUM_THREADS=1
FHS_DEV_OMP_NUM_THREADS=1
FHS_DEV_NUMEXPR_MAX_THREADS=1
FHS_DEV_MALLOC_ARENA_MAX=2

JUPYTER_MEMORY_LIMIT=16g

NOTEBOOK_CHECK_MEMORY_LIMIT=24g
NOTEBOOK_CHECK_OPENBLAS_NUM_THREADS=1
NOTEBOOK_CHECK_MKL_NUM_THREADS=1
NOTEBOOK_CHECK_OMP_NUM_THREADS=1
NOTEBOOK_CHECK_NUMEXPR_MAX_THREADS=1
NOTEBOOK_CHECK_MALLOC_ARENA_MAX=2

DOCS_MEMORY_LIMIT=2g

DELIVERY_BENCHMARK_LEVELS=1000000
DELIVERY_BENCHMARK_TARGET_SCENARIOS=1000000
DELIVERY_BENCHMARK_OUTPUT=tests/spikes/results/delivery_risk_scaling.json

HOST_UID=1000
HOST_GID=1000
